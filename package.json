{
  "name": "ebirdtripplanner",
  "version": "2.0.0-beta.1",
  "author": "Raphaël Nussbaumer",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafnuss/eBirdTripPlanner.git"
  },
  "homepage": "https://github.com/rafnuss/eBirdTripPlanner",
  "bugs": {
    "url": "https://github.com/rafnuss/eBirdTripPlanner/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "download-taxo": "node scripts/download_taxonomy.js",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "perf:large-import": "node tests/perf/large-import.mjs",
    "perf:fixture": "node tests/perf/make-ebd-fixture.mjs",
    "test:cloud:rules": "firebase emulators:exec --project demo-ebird-trip-planner --only firestore,storage \"node tests/cloud/rules.mjs\"",
    "test:workspace": "firebase emulators:exec --project demo-ebird-trip-planner --only auth,firestore,storage \"node tests/cloud/rules.mjs && node tests/workspace/flow.mjs\"",
    "perf:workspace": "node tests/perf/workspace-flow.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:unused": "knip",
    "check": "npm run lint && npm run format:check && npm run check:unused && npm test"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-geocoder": "^5.1.2",
    "@turf/turf": "^7.3.4",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootswatch": "^5.3.8",
    "dexie": "^4.4.2",
    "firebase": "^12.19.0",
    "jszip": "^3.10.1",
    "mapbox-gl": "^3.21.0",
    "papaparse": "^5.5.3",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "firebase-tools": "^14.27.0",
    "globals": "^17.4.0",
    "knip": "^6.42.0",
    "playwright": "^1.59.1",
    "prettier": "^3.9.10",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0"
  },
  "overrides": {
    "firebase-tools": {
      "tar": "^7.5.22"
    }
  }
}
